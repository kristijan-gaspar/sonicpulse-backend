{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Grouping": {
    "TimeWindowSeconds": 5,
    "RadiusMeters": 1000,
    "MinDeviceCount": 2,
    "CandidateSearchExpansionFactor": 1.1
  },
  "DataRetention": {
    "RetentionHours": 168,
    "CleanupIntervalHours": 6
  }
}
